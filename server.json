{
    "name":"duepilot",
    "JVM":{
        "heapSize":"192",
        "minHeapSize":"64",
        "args":[
            "-XX:MaxMetaspaceSize=128m",
            "-XX:ReservedCodeCacheSize=32m",
            "-Xss512k"
        ]
    },
    "app":{
        "cfengine":"boxlang@1.18.6"
    },
    "web":{
        "webroot":"public",
        "host":"0.0.0.0",
        "http":{
            "port":"8088"
        },
        "rewrites":{
            "enable":true
        },
        "aliases":{
            "/coldbox/system/exceptions":"./lib/coldbox/system/exceptions/",
            "/tests":"./tests/"
        }
    },
    "cfconfig":{
        "file":"./.cfconfig.json"
    },
    "scripts":{
        "onServerInstall":[
            "install bx-esapi,bx-compat-cfml,bx-ai@3.5.0,bx-postgresql"
        ]
    },
    "help":true
}
