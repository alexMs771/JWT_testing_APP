# ColdBox Name and Environment
APPNAME=DuePilot
ENVIRONMENT=development
DATA_MODE=postgres

# Database Information
DB_CONNECTIONSTRING=jdbc:postgresql://127.0.0.1:5432/duepilot
DB_DRIVER=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=duepilot
DB_USER=duepilot
DB_PASSWORD=change-me-for-local-development

# JWT Information
JWT_SECRET=replace-with-a-long-random-secret-before-production

# Platform administrator bootstrap. Set these only in your private .env or
# deployment secret manager. The administrator signs in through the normal form
# and is routed to the protected /admin area.
PLATFORM_ADMIN_NAME=DuePilot Administrator
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# DuePilot AI (server-side only)
# Create a key in the Groq console, then set it in your local .env or hosting
# provider's secret manager. Never commit a real key.
AI_ASSISTANT_ENABLED=true
AI_FALLBACK_ENABLED=true
GROQ_API_KEY=
# Optional failover pool. DuePilot rotates the starting slot and tries the next
# configured key only when a provider request fails. Never commit real values.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
# Alternative for secret managers that prefer one value: comma-separated keys.
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=12
GROQ_MAX_TOKENS=700

# S3 Information
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_DOMAIN=amazonaws.com
