{
    "name":"duepilot",
    "version":"1.0.0",
    "author":"DuePilot",
    "shortDescription":"A receivables command center for invoice follow-up, payment promises and collections.",
    "location":"forgeboxStorage",
    "slug":"duepilot",
    "createPackageDirectory":false,
    "type":"mvc",
    "keywords":[],
    "repository":{
        "type":"",
        "url":""
    },
    "ignore":[],
    "dependencies":{
        "coldbox":"^8.0.0",
        "cf-token-manager":"github:alexMs771/cf-token-manager"
    },
    "devDependencies":{
        "testbox":"*",
        "route-visualizer":"*",
        "commandbox-boxlang":"*",
        "commandbox-cfformat":"*"
    },
    "installPaths":{
        "coldbox":"lib/coldbox/",
        "testbox":"lib/testbox/",
        "route-visualizer":"lib/modules/route-visualizer/",
        "cf-token-manager":"lib/modules/cf-token-manager/"
    },
    "installPathConventions":{
        "modules":"lib/modules"
    },
    "scripts":{
        "postInstall":"pathExists .env || cp .env.example .env",
        "format":"cfformat run app/,tests/specs/,*.cfc --overwrite --verbose",
        "format:check":"cfformat check app/,tests/specs/,*.cfc ./.cfformat.json --verbose",
        "format:watch":"cfformat watch path='app/**/*.cfc,tests/specs/,*.cfc' settingsPath='.cfformat.json'",
        "build:docker":"!docker build --no-cache -t my-coldbox-app -f ./docker/Dockerfile ./",
        "run:docker":"!docker run -it -p 8080:8080 my-coldbox-app"
    },
    "testbox":{
        "runner":"/tests/runner.cfm"
    },
    "language":"CFML",
    "description":"DuePilot helps service businesses collect invoices faster and forecast incoming cash."
}
