################################################################
# ColdBox Docker Image
# You can use this docker image to build your own
# You can use the following to build the image
# docker build --no-cache -t my-coldbox-app -f ./Dockerfile ./
# You can use the following to run the image
# docker run -it -p 8080:8080 my-coldbox-app
################################################################

# BoxLang on JDK 21. The warmed image avoids downloading and expanding the
# CFML engine during every deploy or cold start.
# https://hub.docker.com/r/ortussolutions/commandbox
FROM ortussolutions/commandbox:boxlang

# Metadata
LABEL maintainer="Ortus Solutions <info@ortussolutions.com>"
LABEL repository="https://github.com/Ortus-Solutions/docker-commandbox"

# Use the engine already warmed into the base image.
ENV BOX_SERVER_APP_CFENGINE="boxlang"

# Relocate the app off the default /app directory. This app's ColdBox mapping is
# "/app" (-> <root>/app), so hosting the code at the OS path /app collides: any
# absolute path the framework builds (e.g. /app/app/helpers/ApplicationHelper.cfm)
# starts with "/app" and gets re-mapped, producing a broken /app/app/app/... path.
# A non-colliding root avoids this entirely.
ENV APP_DIR="/srv/coldbox"

# ColdBox Healthcheck
ENV HEALTHCHECK_URI="http://127.0.0.1:${PORT}/healthcheck"

# The runtime port remains configurable for local, staging and production hosts.
EXPOSE 8080

# Copy application files to root - Uses .dockerignore to ignore files
COPY ./ ${APP_DIR}/

# Install dependencies, then remove the development dotenv file generated by
# box.json. Runtime environment variables must remain authoritative in images.
RUN cd ${APP_DIR} && box install --production && rm -f .env

# The upstream image can carry an older warmed server definition.  Remove it
# before warmup so server.json's pinned BoxLang runtime is installed instead of
# silently reusing that stale engine.
RUN cd ${APP_DIR} && box server forget --force || true

# WARM UP THE SERVER. server.json installs the pinned bx-ai provider module,
# bx-esapi and CFML compatibility module into the BoxLang runtime at build time.
RUN ${BUILD_DIR}/util/warmup-server.sh

# Generate CommandBox's authoritative startup script while the image is being
# built. Without this, run.sh repeats server discovery and startup-script
# generation whenever a container starts.
#
# PORT is scoped to this build command while runtime secrets remain external.
RUN set -e; export PORT=8080; export FINALIZE_STARTUP=true; ${BUILD_DIR}/run.sh; unset FINALIZE_STARTUP

# Run it
CMD ["/bin/bash", "-c", "$BUILD_DIR/run.sh"]
